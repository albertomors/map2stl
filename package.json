{
  "name": "map2stl",
  "version": "0.6.0",
  "private": true,
  "description": "Pick any place on Earth and turn it into a 3D-printable model (STL / 3MF)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/albertomors/map2stl.git"
  },
  "homepage": "https://github.com/albertomors/map2stl#readme",
  "bugs": "https://github.com/albertomors/map2stl/issues",
  "keywords": [
    "3d-printing",
    "stl",
    "3mf",
    "openstreetmap",
    "maplibre",
    "threejs",
    "map",
    "terrain"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "fflate": "^0.8.3",
    "manifold-3d": "^3.5.4",
    "maplibre-gl": "^6.15.0",
    "pbf": "^5.1.2",
    "polygon-clipping": "^0.15.7",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/geojson": "^7946.0.16",
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4"
  }
}
